OPENROUTER_API_KEY=sk-or-v1-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbG...
NEXUS_API_KEY=generate-with-python-secrets-token_hex
NEXUS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local models (optional) - Kaggle/Colab ngrok
NEXUS_LOCAL_LLM_ENABLED=false
NEXUS_LOCAL_LLM_BASE_URL=https://xxxx.ngrok-free.app
NEXUS_LOCAL_LLM_API_KEY=sk-local-dummy
NEXUS_LOCAL_LLM_MODELS=dolphin3-cyber,ravenx-cyberagent
# Phase 1 AI-native reasoning control loop. Leave blank to use the selected
# local model/OpenRouter routing, or set an explicit registry model ID.
NEXUS_REASONING_MODEL_ID=
# Comma-separated explicit reasoning fallbacks; empty means no extra provider.
NEXUS_REASONING_FALLBACK_MODELS=
NEXUS_RELEASE_SIGNING_KEY=generate-with-python-secrets-token_urlsafe
# Optional hunter/OSINT
GITHUB_TOKEN=ghp_...
SHODAN_API_KEY=
CENSYS_PAT=
TOKENHUB_API_KEY=
TOKENHUB_API_BASE=
# OOB callback service (keep private; never expose through NEXT_PUBLIC_*)
OOB_DOMAIN=
OOB_SERVER_IP=
# Native Interactsh control endpoint; defaults to http://OOB_DOMAIN
OOB_SERVER_URL=
# Legacy Azure adapter; no longer required for native Interactsh polling
OOB_LOGS_ENDPOINT=
OOB_AUTH_TOKEN=

# Stage 2 identity vault. Use a random 32-byte base64/hex value; never commit it.
NEXUS_AUTH_VAULT_KEY=generate-with-python-secrets-token_urlsafe

# Authorized local vulnerable labs (never point these at public targets).
NEXUS_LAB_JUICE_SHOP_URL=http://host.docker.internal:3001
NEXUS_LAB_CRAPI_URL=http://host.docker.internal:8888
NEXUS_LAB_WEBGOAT_URL=http://host.docker.internal:8080
NEXUS_LAB_DVWA_URL=http://host.docker.internal:8081
NEXUS_LAB_OWASP_BENCHMARK_URL=http://host.docker.internal:8446/benchmark/
